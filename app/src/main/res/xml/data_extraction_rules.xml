<?xml version="1.0" encoding="utf-8"?>
<!-- Индекс Still (стопки, оставленное, цвета) не уходит ни в облако, ни на новый телефон:
     он зашифрован ключом этого телефона и без него бесполезен, а пересчитывается сам. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
